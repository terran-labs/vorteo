{
  "schema": "vorteo-factory",
  "version": 1,
  "mode": "lean",
  "release": {
    "channels": {
      "beta": { "tag": "beta", "noticeMinutes": 10 },
      "stable": { "tag": "production" }
    },
    "identity": "artifact",
    "steps": {
      "deployBeta": {
        "where": "host",
        "run": "exec tools/ship.sh \"$VORTEO_RELEASE_NUMBER\" \"$VORTEO_RELEASE_NOTE\" --beta"
      },
      "verifyBeta": {
        "where": "host",
        "run": "line=\"$(grep -v '^#' release-notes/betas.tsv | tail -1)\" && [ -n \"$line\" ] && version=\"$(printf '%s' \"$line\" | cut -f1)\" && commit=\"$(git rev-parse --verify \"$(printf '%s' \"$line\" | cut -f3)^0\")\" && frozen=\"$(printf '%s' \"$line\" | cut -f5)\" && printf '{\"version\":\"%s\",\"commit\":\"%s\",\"artifact\":\"%s\"}\\n' \"$version\" \"$commit\" \"$frozen\""
      },
      "promote": {
        "where": "host",
        "run": "exec tools/ship.sh \"$VORTEO_RELEASE_NUMBER\" \"$VORTEO_RELEASE_NOTE\" --promote \"$VORTEO_RELEASE_ARTIFACT\" --approved \"$VORTEO_RELEASE_VERSION\" --approval \"$VORTEO_RELEASE_APPROVAL\""
      },
      "verifyStable": {
        "where": "container",
        "run": "curl -sf --max-time 15 https://mira.cc/build.json | node -e 'let s=\"\";process.stdin.on(\"data\",(d)=>(s+=d)).on(\"end\",()=>{const b=JSON.parse(s);process.stdout.write(JSON.stringify({version:b.version,commit:null,artifact:b.id})+\"\\n\")})'"
      },
      "rollback": {
        "kind": "redeploy",
        "where": "host",
        "run": "exec tools/rollback.sh \"$VORTEO_RELEASE_TARGET\""
      }
    },
    "gates": { "beta": [], "stable": [] },
    "trigger": { "kind": "every-batch" }
  }
}
